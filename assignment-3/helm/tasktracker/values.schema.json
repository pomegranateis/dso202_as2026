{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environment", "image", "frontend", "backend", "credentials"],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["dev", "prod"],
      "description": "Target environment; must be set explicitly"
    },
    "image": {
      "type": "object",
      "required": ["repositoryPrefix"],
      "properties": {
        "repositoryPrefix": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "service": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort"]},
            "nodePort": {"type": "integer", "minimum": 30000, "maximum": 32767}
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {"replicaCount": {"type": "integer", "minimum": 1}}
    },
    "credentials": {
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "username": {"type": "string", "minLength": 1},
        "password": {"type": "string"}
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"}
      }
    }
  }
}
